# Base ServiceNow configuration
# Full instance URL, for example: https://example.service-now.com
SERVICENOW_INSTANCE_URL=

# OAuth client ID from the ServiceNow OAuth application registry
SERVICENOW_CLIENT_ID=

# OAuth client secret from the ServiceNow OAuth application registry
SERVICENOW_CLIENT_SECRET=

# Supported values: client_credentials, password, authorization_code, refresh_token
SERVICENOW_OAUTH_GRANT_TYPE=client_credentials

# Required only when SERVICENOW_OAUTH_GRANT_TYPE=password
SERVICENOW_USERNAME=
SERVICENOW_PASSWORD=

# Required only when SERVICENOW_OAUTH_GRANT_TYPE=authorization_code
# One-time code issued by ServiceNow for the configured redirect URI
SERVICENOW_AUTHORIZATION_CODE=
SERVICENOW_REDIRECT_URI=

# Required only when SERVICENOW_OAUTH_GRANT_TYPE=refresh_token
SERVICENOW_REFRESH_TOKEN=
