# SPIE (ServiceNow Platform Intelligence Engine) configuration.
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# .env is gitignored. Never commit real credentials.
# SPIE reads .env from the directory it is started in (see the Claude Desktop setup in README.md).

# --- Required for every grant type -------------------------------------------------------------

# Your instance URL, with no trailing path.
SERVICENOW_INSTANCE_URL=https://your-instance.service-now.com

# Client ID of the OAuth integration you created in ServiceNow.
SERVICENOW_CLIENT_ID=

# One of: interactive, client_credentials, password, authorization_code, refresh_token
# "interactive" (recommended) signs you in through your browser; see README.md for the setup.
SERVICENOW_OAUTH_GRANT_TYPE=interactive

# --- interactive (recommended) -----------------------------------------------------------------
# The integration must be an "OAuth - Authorization code grant" with the Table API auth scope.

# Optional. Leave empty for a public client (the "This is a public client" checkbox).
SERVICENOW_CLIENT_SECRET=

# Optional. Local address that receives the browser sign-in response. Must be an http loopback URL
# with an explicit port, and must exactly match the Redirect URL registered in ServiceNow.
# SERVICENOW_REDIRECT_URI=http://127.0.0.1:8765/callback

# --- Other grant types (uncomment what your grant type needs) ----------------------------------
# These grants require SERVICENOW_CLIENT_SECRET above.

# client_credentials: nothing more is required.

# password:
# SERVICENOW_USERNAME=
# SERVICENOW_PASSWORD=

# authorization_code (code pasted in manually; the redirect URI is required for this grant):
# SERVICENOW_AUTHORIZATION_CODE=
# SERVICENOW_REDIRECT_URI=

# refresh_token:
# SERVICENOW_REFRESH_TOKEN=
